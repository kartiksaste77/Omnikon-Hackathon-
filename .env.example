# SkillSwap Environment Variables
# Copy this file to .env.local and fill in the values

# ────────────────────────────────────────
# Database (SQLite — default, no config needed)
# ────────────────────────────────────────
# DATABASE_URL is auto-configured via prisma7.config.ts for SQLite
# For production PostgreSQL, uncomment and fill:
# DATABASE_URL="postgresql://user:password@host:5432/skillswap"

# ────────────────────────────────────────
# Authentication
# ────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ────────────────────────────────────────
# App
# ────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────
# For Vercel deployment:
# Set these in the Vercel dashboard → Project → Settings → Environment Variables
# JWT_SECRET=<long-random-string>
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# ────────────────────────────────────────
